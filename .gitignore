# ── Private strategy docs — deliberately not published ──────────
docs/strategy.md
docs/*.html

# ── Secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example
.dev.vars
*.key
*.pem

# ── Node ───────────────────────────────────────────────────────
node_modules/
dist/
.astro/
.wrangler/
*.tsbuildinfo

# ── Python ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# ── Media & render artefacts (never commit binaries) ───────────
out/
renders/
*.mp4
*.mov
*.wav
*.mp3
media_cache/

# …with one exception. The raw narration takes are a *source* asset: they came
# from a paid API and re-fetching them costs credits, and the shot plan takes
# each scene's length from the audio, so without them a clone renders a silent
# video with the wrong timing — which fails quietly. Half a megabyte.
#
# The processed files beside them are generated by `pnpm voice` and are not
# committed: trimming, speed and loudness are constants in that script, so the
# way the voice sounds is a diff rather than eight more generations.
!packages/render/public/vo/
!packages/render/public/vo/raw/
!packages/render/public/vo/raw/*.mp3

# The subsetted typeface is committed as `src/font-data.ts`, inlined — the
# .woff2 files under public/ are an intermediate that `pnpm fonts` rebuilds.

# ── OS / editor ────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ── Vendored agent skills ──────────────────────────────────────
# Regenerate with `npx skills add remotion-dev/skills`; skills-lock.json
# pins the versions and is committed. 3.4 MB of someone else's markdown
# does not belong in this history.
.agents/
.claude/
