# Copy to .env and fill in. Never commit real values.

# ── Supabase (Laris has its own project — not the shared identity pool) ──
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-side only, never ships to the browser

# ── Google Business Profile ──
# Quota defaults to 0 — the increase request is a prerequisite, file it early.
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=

# ── ElevenLabs (voice, music, SFX) ──
ELEVENLABS_API_KEY=

# ── Perception VLM ──
GEMINI_API_KEY=
QWEN_BASE_URL=                      # OpenAI-compatible endpoint for bulk teardowns
QWEN_API_KEY=

# ── Telegram bot ──
TELEGRAM_BOT_TOKEN=

# ── Postiz (self-hosted; called over HTTP, never forked) ──
POSTIZ_BASE_URL=
POSTIZ_API_KEY=
